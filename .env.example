# Server
PORT=3000
NODE_ENV=development

# Auth: set a strong secret in production (required when NODE_ENV=production)
JWT_SECRET=your-secret-key-min-32-chars

# Optional: token expiry (default: 7d)
# JWT_EXPIRES_IN=7d

# Optional: override the first-time admin username (default: admin).
# ADMIN_INITIAL_USERNAME=admin

# Optional: override the first-time admin password (default: admin123). User must change it after first login.
# ADMIN_INITIAL_PASSWORD=your-initial-password

# Optional: custom database path (default: ./data/reviews.db – not web-accessible)
# DATABASE_PATH=./data/reviews.db

# Optional: restrict CORS to specific origins (comma-separated). Leave unset to allow all origins in dev.
# ALLOWED_ORIGINS=https://yourdomain.com

# Optional: max rows in CSV export (default: 50000)
# CSV_EXPORT_LIMIT=50000
